[Unit]
Description=Controid Linux-Android Ecosystem Daemon
After=graphical-session.target bluetooth.target NetworkManager.service
Wants=bluetooth.target NetworkManager.service

[Service]
Type=simple
ExecStart=%h/.local/bin/controidd
Restart=on-failure
RestartSec=3
Environment=RUST_LOG=info

[Install]
WantedBy=graphical-session.target
